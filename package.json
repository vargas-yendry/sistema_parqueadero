{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "parqueadero-yg",
  "version": "3.0.0",
  "description": "Sistema de parqueadero Y&G — app de escritorio (Electron) con API Express + SQLite e interfaz React.",
  "author": "Jemg <murksopps@gmail.com>",
  "homepage": "https://jemg.dev",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "desktopName": "parqueadero-yg.desktop",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "dev": "concurrently -n api,ui -c blue,magenta \"pnpm run dev:api\" \"pnpm run dev:ui\"",
    "dev:api": "node --watch src/servidor/index.js",
    "dev:ui": "vite",
    "api": "node src/servidor/index.js",
    "build": "pnpm run build:ui && pnpm run build:servidor",
    "build:ui": "vite build",
    "build:servidor": "vite build --config vite.servidor.config.js",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "electron": "electron .",
    "dist:linux": "pnpm run build && electron-builder --linux",
    "dist:win": "pnpm run build && electron-builder --win"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/rajdhani": "5.3.0",
    "@hookform/resolvers": "5.5.7",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "8.21.3",
    "axios": "1.18.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cors": "2.8.6",
    "date-fns": "4.4.0",
    "express": "5.2.1",
    "lucide-react": "1.27.0",
    "motion": "12.42.2",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.83.0",
    "sonner": "2.0.7",
    "sqlite3": "6.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "10.0.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-plugin-sonarjs": "4.2.0",
    "globals": "17.8.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.3",
    "@rollup/rollup-win32-x64-msvc": "4.62.3",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.3"
  }
}
